{
  "name": "amane-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/ensure-schema.mjs && vite",
    "build": "node scripts/ensure-schema.mjs && vue-tsc --noEmit && vite build",
    "typecheck": "node scripts/ensure-schema.mjs && vue-tsc --noEmit",
    "preview": "vite preview",
    "generate": "openapi-typescript openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.18.6",
    "@vitejs/plugin-vue": "^6.0.1",
    "openapi-typescript": "^7.9.1",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vue-tsc": "^3.1.1"
  }
}
